# Alpaca API credentials. Start with PAPER keys only.
ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me

# Keep both values safe by default. Live trading requires explicit opt-in.
ALPACA_PAPER=true
GGYT_DRY_RUN=true
GGYT_ALLOW_LIVE_TRADING=false
GGYT_CONFIRM_LIVE_ACCOUNT_ID=
GGYT_LIVE_CONFIRMATION=

# Local-only hard safety defaults. Do not change for normal desktop execution.
RUN_MODE=LOCAL_ONLY
ALLOW_REMOTE=false
ALLOW_WEBHOOKS=false
ALLOW_EXTERNAL_COMMANDS=false
GGYT_BIND_HOST=127.0.0.1
GGYT_DB_PATH=data/trading.sqlite3

# Broker selection: ALPACA, MT5, or PAPER. MT5 is local-terminal only.
BROKER=ALPACA
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_MAGIC_NUMBER=888888
MT5_TIMEOUT=60000
MT5_MAX_SLIPPAGE=10
MT5_MAX_SPREAD_PCT=0.003
MT5_DEFAULT_RISK_PERCENT=0.005
MT5_AUTO_RECONNECT=true
MT5_ALLOWED_SYMBOLS=EURUSD,XAUUSD,GBPUSD,US100,USDJPY,NAS100,SPX500
GGYT_CONFIRM_MT5_ACCOUNT=
